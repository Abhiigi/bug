    void retrieveLastCSRequestPersonException(){
        PreparedStatementQuery query = createPreparedStatement("""
            SELECT
              A.SEQNO,
              A.MESSAGE_CAT_NBR,
              A.MESSAGE_NBR,
              A.LOG_DTTM
            FROM 
              C1_CS_REQ_PER_LOG A
            WHERE
              A.CS_REQ_PER_ID = :custSvcReqPersonId
              AND A.LOG_ENTRY_TYPE_FLG = 'F1EX'
            ORDER BY A.LOG_DTTM DESC
        """, 'Retrieve CS Request Person Exception Log');
        query.bindEntity("custSvcReqPersonId", new CustomerServiceRequestPerson_Id(getStringScriptVariable('custSvcReqPersonId')).getEntity()); 
        SQLResultRow row = query.firstRow();
        if (isNull(row)) return;
        setIntegerScriptVariable 'sequenceNumber', row.getInteger('SEQNO');
    }
    
