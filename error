     // move hard parms to work variables
     move "parm/hard/person/id" to $personId;
     move "parm/hard/isPrimary" to $inPrimaryName;
     move "parm/hard/sequence" to $inSequence;
     move "parm/soft[1]/value" to $contactTypeBUSN;
     move "parm/soft[2]/value" to $contactTypeBUSA;
     move "parm/soft[3]/value" to $contactTypePERS;
     move "parm/soft[4]/value" to $contactTypePERA;
     // set constants and defaults
     move 'PRIM' to $nameTypePRIM;
     move 'ALT' to $nameTypeALT;
     move 'C1YS' to $primaryContactYes;
     move 'N' to $displayContact;
     move '' to $entityName;
     move '' to $entityInfo;
     move '' to $entityNamePRIM;
     move '' to $entityNameSEQ;
     move '' to $entityNameALT;
     move '' to $nameType;
     move '' to $wNameType;
     move '' to $wContactType;
     move '' to $wContactTypeDescr;
     // read Person
     move "$personId" to "C1-PersonNameContact/personId";
     invokeBO 'C1-PersonNameContact' using "C1-PersonNameContact" for read;
     move "C1-PersonNameContact/personOrBusiness" to $personOrBusiness;
     // process names
     for ($NameList in "C1-PersonNameContact/personName")
          move "$NameList/nameType" to $nameType;
          move "$NameList/sequence" to $sequence;
          if ("$nameType = $nameTypePRIM")
               move "$NameList/entityName" to $entityNamePRIM;
          end-if;
          if ("$nameType = $nameTypeALT")
               move "$NameList/entityName" to $entityNameALT;
          end-if;
          if ("$sequence = $inSequence")
               move "$NameList/entityName" to $entityNameSEQ;
               move "$nameType" to $wNameType;
          end-if;
     end-for;
     if ("$inPrimaryName = 'true'")
          move "$nameTypePRIM" to $wNameType;
          move "$entityNamePRIM" to $entityName;
     else
          if ("$inSequence != '0'")
               move "$entityNameSEQ" to $entityName;
          else
               move "$nameTypePRIM" to $wNameType;
               move "$entityNamePRIM" to $entityName;
          end-if;
     end-if;
     move "$entityName" to $entityInfo;
     if ("$wNameType = $nameTypePRIM")
          if ("$entityNameALT > $BLANK")
               move "concat($entityInfo, ' (', $entityNameALT, ')' )" to $entityInfo;
          end-if;
     end-if;
     if ("$wNameType != $nameTypePRIM")
          if ("$entityNamePRIM != $BLANK")
               move "concat($entityInfo, ' (', $entityNamePRIM, ')' )" to $entityInfo;
          end-if;
     end-if;
     move '' to $contact;
     // ======================
     // BUSINESS CONTACTS
     // ======================
     if ("$personOrBusiness = 'B'")
          if ("$contactTypeBUSN >  $BLANK")
               for ($ContactList in "C1-PersonNameContact/personContactDetail")
                    move "$ContactList/personContactType" to $contactType;
                    move "$ContactList/contactDetailValue" to $contactDetail;
                    move "$ContactList//contactDetailPrimary" to $isPrimaryContact;
                    move "$ContactList/contactDetailActiveInactive" to $contactStatus;
                    if ("$contactType = $contactTypeBUSN")
                         if ("$contactStatus = 'C1AC'")
                              move "$contactDetail" to $contact;
                              move "$contactType" to $wContactType;
                              if ("$isPrimaryContact = $primaryContactYes")
                                   goto endContacts1;
                              end-if;
                         end-if;
                    end-if;
               end-for;
          end-if;
          if ("$contact > $BLANK")
               goto endContacts1;
          end-if;
          if ("$contactTypeBUSA >  $BLANK")
               for ($ContactList in "C1-PersonNameContact/personContactDetail")
                    move "$ContactList/personContactType" to $contactType;
                    move "$ContactList/contactDetailValue" to $contactDetail;
                    move "$ContactList//contactDetailPrimary" to $isPrimaryContact;
                    move "$ContactList/contactDetailActiveInactive" to $contactStatus;
                    if ("$contactType = $contactTypeBUSA")
                         if ("$contactStatus = 'C1AC'")
                              move "$contactDetail" to $contact;
                              move "$contactType" to $wContactType;
                              if ("$isPrimaryContact = $primaryContactYes")
                                   goto endContacts1;
                              end-if;
                         end-if;
                    end-if;
               end-for;
          end-if;
     end-if;
     // ======================
     // PERSON CONTACTS
     // ======================
     if ("$personOrBusiness = 'P'")
          if ("$contactTypePERS >  $BLANK")
               for ($ContactList in "C1-PersonNameContact/personContactDetail")
                    move "$ContactList/personContactType" to $contactType;
                    move "$ContactList/contactDetailValue" to $contactDetail;
                    move "$ContactList//contactDetailPrimary" to $isPrimaryContact;
                    move "$ContactList/contactDetailActiveInactive" to $contactStatus;
                    if ("$contactType = $contactTypePERS")
                         if ("$contactStatus = 'C1AC'")
                              move "$contactDetail" to $contact;
                              move "$contactType" to $wContactType;
                              if ("$isPrimaryContact = $primaryContactYes")
                                   goto endContacts1;
                              end-if;
                         end-if;
                    end-if;
               end-for;
          end-if;
          if ("$contact > $BLANK")
               goto endContacts1;
          end-if;
          if ("$contactTypePERA >  $BLANK")
               for ($ContactList in "C1-PersonNameContact/personContactDetail")
                    move "$ContactList/personContactType" to $contactType;
                    move "$ContactList/contactDetailValue" to $contactDetail;
                    move "$ContactList//contactDetailPrimary" to $isPrimaryContact;
                    move "$ContactList/contactDetailActiveInactive" to $contactStatus;
                    if ("$contactType = $contactTypePERA")
                         if ("$contactStatus = 'C1AC'")
                              move "$contactDetail" to $contact;
                              move "$contactType" to $wContactType;
                              if ("$isPrimaryContact = $primaryContactYes")
                                   goto endContacts1;
                              end-if;
                         end-if;
                    end-if;
               end-for;
          end-if;
     end-if;
     endContacts1: move ' ' to $dummy;
     // build entity info
     move "$entityName" to $entityInfo;
     if ("$wContactType > $BLANK")
          move "$wContactType" to "C1-PersonContactType/personContactType";
          invokeBO 'C1-PersonContactType' using "C1-PersonContactType" for read;
          move "C1-PersonContactType/description" to $wContactTypeDescr;
          move "concat($entityInfo, ' - ', $wContactTypeDescr, ':' )" to $entityInfo;
          move "concat($entityInfo,  $contact )" to $entityInfo;
     end-if;
     buildinfo: move "$entityName" to "parm/hard/personNameString";
     move "$entityInfo" to "parm/hard/personInformation";
end-edit;
