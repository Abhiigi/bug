// 190: Format Date Time to MM-DD-YYYY

    public void getCorrectFormatDate(){
      
        String stringDate = evalString('$inputString');
       
        DateFormat dateFormat = new DateFormat("MM-dd-yyyy");
        DateFormat dateFormat2 = new DateFormat("yyyy-MM-dd"); 
            
        if (Date.isValidDateString(stringDate, dateFormat)){
            setStringScriptVariable('outputDate', stringDate);
            return;
        }else if (Date.isValidDateString(stringDate, dateFormat2)){
            setStringScriptVariable('outputDate', dateFormat.format(dateFormat2.parseDate(stringDate))); 
            return;
        }
    
        setStringScriptVariable('outputDate', 'NA');
    }

